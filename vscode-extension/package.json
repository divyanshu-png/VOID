{
  "name": "void",
  "displayName": "VOID Agentic Code Reviewer",
  "description": "Security findings as you save, and verified one-click fixes: every patch must pass a Bandit re-scan and sandboxed tests.",
  "version": "0.2.0",
  "publisher": "void-adgips",
  "repository": {
    "type": "git",
    "url": "https://github.com/divyanshu-png/VOID"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "void.fixAtCursor",
        "title": "VOID: Fix Vulnerability at Cursor"
      },
      {
        "command": "void.auditCurrentFile",
        "title": "VOID: Audit & Refactor Whole File"
      },
      {
        "command": "void.scanFile",
        "title": "VOID: Scan File for Vulnerabilities"
      },
      {
        "command": "void.openDashboard",
        "title": "VOID: Open Dashboard"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "void.fixAtCursor",
          "when": "editorLangId == python",
          "group": "navigation@1"
        },
        {
          "command": "void.auditCurrentFile",
          "when": "editorLangId == python",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "VOID",
      "properties": {
        "void.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the VOID backend."
        },
        "void.dashboardUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "URL of the VOID web dashboard (npm run dev serves it on :5173)."
        },
        "void.oracleMode": {
          "type": "string",
          "enum": [
            "auto",
            "dual",
            "exec",
            "sast",
            "single"
          ],
          "enumDescriptions": [
            "C4: autonomous: both oracles + a critic agent must pass; a supervisor agent picks each next step (recommended)",
            "C3: accept a patch only when the Bandit re-scan AND the generated tests pass",
            "C2: generated tests only",
            "C1: Bandit re-scan only",
            "C0: one attempt, no feedback loop"
          ],
          "default": "auto",
          "description": "Which oracles must pass before a patch is accepted."
        },
        "void.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run a fast Bandit + package scan (no AI) whenever a Python file is saved."
        },
        "void.timeoutSeconds": {
          "type": "number",
          "default": 300,
          "description": "Maximum time to wait for a repair."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "vsix": "vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
