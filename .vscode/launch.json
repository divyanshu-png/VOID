// Press F5 (Run and Debug > "Run VOID extension") to open a second VS Code window
// with the extension loaded from vscode-extension/. Start the backend first (cd frontend && npm run dev).
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run VOID extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"],
      "outFiles": ["${workspaceFolder}/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "build VOID extension"
    }
  ]
}
