# Copy to backend/.env and fill in.

# --- LLM (required for real reviews) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
# auto = detect from the key: "AQ." keys are Vertex AI express keys, "AIza" keys are Gemini API keys
GOOGLE_GENAI_USE_VERTEXAI=auto

# --- Agent loop ---
# single (C0) | sast (C1) | exec (C2) | dual (C3, default)
ORACLE_MODE=dual
MAX_RETRIES=3

# --- Sandbox for running generated tests ---
# auto = Docker if the void-sandbox image is built, else hardened subprocess
SANDBOX_MODE=auto
SANDBOX_IMAGE=void-sandbox:latest
SANDBOX_TIMEOUT=10
SANDBOX_MEMORY_MB=256

# --- Repo mode (optional) ---
# A GitHub token raises the API rate limit for "random repo from user".
GITHUB_TOKEN=

# --- Offline development ---
# 1 = use the rule-based stub instead of Gemini (UI testing without a key; NOT an AI)
VOID_STUB_LLM=0
